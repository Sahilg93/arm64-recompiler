      "code": "if (arg0) {\n    for (unsigned o = 0; o < 48; o += 8) guest_store(arg0 + o, 0, 8);\n    guest_store(arg0, 9, 2); /* PROCESSOR_ARCHITECTURE_AMD64 = 9 */\n    guest_store(arg0 + 4, 4096, 4); /* PageSize = 4096 */\n    guest_store(arg0 + 8, 0x10000, 8); /* MinimumApplicationAddress */\n    guest_store(arg0 + 16, 0x7ffffffeffff, 8); /* MaximumApplicationAddress */\n    guest_store(arg0 + 24, 0xff, 8); /* ActiveProcessorMask = 8 cores */\n    guest_store(arg0 + 32, 8, 4); /* NumberOfProcessors = 8 */\n    guest_store(arg0 + 36, 8664, 4); /* ProcessorType = PROCESSOR_AMD64_X8664 */\n    guest_store(arg0 + 40, 65536, 4); /* AllocationGranularity = 64KB */\n}\nreturn 0;"
