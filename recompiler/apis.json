      "name": "WriteConsoleW",
      "params": [
        "u64 hConsole",
        "u64 lpBuffer",
        "u32 nChars",
        "u64 lpWritten",
        "u64 lpReserved"
      ],
      "ret": "u32",
      "code": "{\n    (void)arg0;\n    uint32_t count = (uint32_t)arg2;\n    for (uint32_t i = 0; i < count; ++i) {\n        uint16_t ch = (uint16_t)guest_load(arg1 + i * 2, 2);\n        if (ch < 128) putchar((char)ch);\n        else putchar('?');\n    }\n    if (arg3) guest_store(arg3, count, 4);\n    return 1;\n}"
    },
